{
  "name": "dsh-bookshelf",
  "version": "0.3.0",
  "description": "A local PDF and EPUB bookshelf for the DSH Web GUI with built-in readers and a shelf-owned Books sidebar.",
  "type": "module",
  "icon": "icon.svg",
  "author": "Chriszzx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chriszzx/dsh-bookshelf.git"
  },
  "homepage": "https://github.com/Chriszzx/dsh-bookshelf#readme",
  "bugs": {
    "url": "https://github.com/Chriszzx/dsh-bookshelf/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "harness",
    "dsh",
    "dsh-plugin",
    "bookshelf",
    "ebook",
    "epub",
    "pdf"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "sidebar.js",
    "apple-books.js",
    "link-source.js",
    "source-revision.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/**",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin",
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "os": [
    "darwin",
    "win32"
  ]
}
